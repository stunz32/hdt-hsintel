<UserControl x:Class="HSIntel.Overlay.Controls.CoachHudShell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             MinWidth="220"
             MinHeight="120">
    <Border CornerRadius="8"
            Background="#CC1C1C1F"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            Padding="10"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="HeaderRegion"
                    Grid.Row="0"
                    Background="#22101010"
                    CornerRadius="4"
                    Padding="6"
                    Cursor="SizeAll">
                <DockPanel LastChildFill="False">
                    <TextBlock Text="HS Intel Coach"
                               FontWeight="SemiBold"
                               Foreground="#F0FFFFFF"
                               VerticalAlignment="Center"/>
                    <ToggleButton x:Name="ToggleState"
                                  Width="52"
                                  Height="22"
                                  Margin="10,0,0,0"
                                  VerticalAlignment="Center"
                                  IsHitTestVisible="False"
                                  Focusable="False"
                                  IsChecked="{Binding IsCoachEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  Content="On"
                                  ToolTip="Enable or disable coaching (stub)"/>
                </DockPanel>
            </Border>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Left">
                <TextBlock Text="Status:"
                           Foreground="#AAFFFFFF"
                           Margin="0,0,6,0"/>
                <TextBlock x:Name="StatusText"
                           Text="Initializing"
                           Foreground="#FFFFFFFF"
                           FontWeight="Bold"/>
            </StackPanel>

            <Border Grid.Row="2"
                    Margin="0,12,0,0"
                    Background="#22000000"
                    CornerRadius="4"
                    Padding="8">
                <StackPanel>
                    <TextBlock Text="Next Action"
                               Foreground="#AAFFFFFF"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="ActionPlaceholder"
                               Text="Waiting for engine..."
                               Foreground="#DDFFFFFF"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"/>
                    <Button x:Name="SettingsButton"
                            FontFamily="Segoe MDL2 Assets" Content="&#xE713;"
                            HorizontalAlignment="Left"
                            Margin="0,12,0,0"
                            Padding="10,4"
                            ToolTip="Open HS Intel settings (stub)"
                            IsEnabled="False"
                            IsHitTestVisible="False"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>

